# GaganDrishti Environment Template
# Duplicate this file as .env.local for local overrides.
# NOTE: .env* files are git-ignored to prevent credential leaks.

NODE_ENV=development

# Optional Gemini AI Assistant integration
# If omitted or invalid, GaganDrishti automatically uses its offline deterministic fallback engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
