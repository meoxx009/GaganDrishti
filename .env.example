# GaganDrishti Environment Template
# Duplicate this file as .env.local for local overrides.
# NOTE: .env* files are git-ignored to prevent credential leaks.

NODE_ENV=development

# Gemini AI Assistant Integration
# Used by Ask GaganDrishti conversational assistant
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_key_here

# Twilio SMS Gateway Integration
# Used for SMS advisory broadcast to feature phone farmers
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Antigravity & Internal API Integration
ANTIGRAVITY_API_KEY=your_antigravity_key_here

# URLs & Endpoints
NEXT_PUBLIC_API_URL=http://localhost:3000/api
